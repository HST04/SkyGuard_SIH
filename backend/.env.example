# SkyGuard AI Backend Environment Configuration

# OpenRouter API Key for Multi-Agent Debate
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Model to use (e.g. anthropic/claude-3.5-sonnet, openai/gpt-4o-mini, meta-llama/llama-3.3-70b-instruct)
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Database path (stored locally)
DATABASE_PATH=skyguard.db

# Station ID
DEFAULT_STATION_ID=AGRA-01
